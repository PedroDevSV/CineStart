# Copia este archivo como .env y rellénalo. El .env NO se sube a GitHub.

# Neon (PostgreSQL)
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require
# o, en una sola línea: DATABASE_URL=postgresql://usuario:contraseña@host/base?sslmode=require

# MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:CONTRASEÑA@cinestartpeliculas.xl0sqxj.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=cinestart

# TMDB: «API Read Access Token» de https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# Cadena larga y aleatoria: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Opcional
# ARTEFACTOS=../artefactos
# CORS_ORIGINS=http://localhost:5173,http://localhost:5180
