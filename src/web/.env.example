# true  -> la web funciona sola con datos de ejemplo (src/api/mock)
# false -> llama a la API real de FastAPI en VITE_API_URL
VITE_USE_MOCKS=true

# URL base de la API FastAPI (sin barra final)
VITE_API_URL=http://localhost:8000

# browser -> rutas limpias (/pelicula/27205); necesita que el servidor devuelva index.html en cualquier ruta
# hash    -> rutas con # (/#/pelicula/27205); funciona en cualquier hosting estático
VITE_ROUTER_MODE=browser

# Base de las imágenes de TMDB (pósters). Normalmente no hace falta cambiarla.
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
