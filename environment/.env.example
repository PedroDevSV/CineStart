# Copia este archivo como environment/.env y rellénalo. El .env NO se sube a GitHub.
# Cada servicio lee solo lo que necesita; elige UN modo de datos (local o nube).

# --- Modo LOCAL (perfil "local" del compose: Postgres y Mongo en contenedores) ---
DATABASE_URL=postgresql://cinestart:cinestart@postgres:5432/cinestart
MONGO_URI=mongodb://mongo:27017

# --- Modo NUBE (Neon + Atlas): pídele las cadenas al equipo y sustituye las dos líneas de arriba ---
# DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
# MONGO_URI=mongodb+srv://USUARIO:CONTRASEÑA@cinestartpeliculas.xl0sqxj.mongodb.net/?retryWrites=true&w=majority

MONGO_DB=cinestart

# TMDB: «API Read Access Token» de https://www.themoviedb.org/settings/api (opcional)
TMDB_TOKEN=

# Cadena larga y aleatoria: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Origen de la web servida por Docker
CORS_ORIGINS=http://localhost:8080
